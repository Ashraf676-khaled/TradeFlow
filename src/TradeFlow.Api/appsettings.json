{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=tradeflow.db"
  },
  "Jwt": {
    "Secret":"",
    "Issuer": "TradeFlow.Api",
    "Audience": "TradeFlow.Client",
    "ExpiryInMinutes": 60
  },
  "AllowedHosts": "tradeflow.runasp.net"
}
