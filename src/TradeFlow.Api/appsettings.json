{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": true
  },
  "Jwt": {
    "Issuer": "TradeFlow.Api",
    "Audience": "TradeFlow.Client",
    "ExpiryInMinutes": 480
  },
  "PlatformAdmin": {
    "UserId": "01A127D5-EF4E-7EC1-B242-ACE1A6143EB3"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "DisplayName": "TradeFlow"
  },
  "GoogleAuth": {
    "ClientId": ""
  },
  "AllowedHosts": "tradeflow.runasp.net"
}
