{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": true
  },
  "Jwt": {
    "Secret": "CHANGE_ME_TO_A_RANDOM_KEY_AT_LEAST_32_BYTES_LONG",
    "Issuer": "TradeFlow.Api",
    "Audience": "TradeFlow.Client",
    "ExpiryInMinutes": 480
  },
  "PlatformAdmin": {
    "UserId": "01A127D5-EF4E-7EC1-B242-ACE1A6143EB3"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Email": "YOUR_GMAIL_ADDRESS@gmail.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD",
    "DisplayName": "TradeFlow"
  },
  "GoogleAuth": {
    "ClientId": "398001640142-9ampkcvvqrgla6e3pgdn0hfrj3hvfsu.apps.googleusercontent.com",
    "ClientSecret": "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
  },
  "AllowedHosts": "tradeflow.runasp.net"
}
