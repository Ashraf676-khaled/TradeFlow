{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb; Database=TradeFlow_Dev; Trusted_Connection=True; MultipleActiveResultSets=True;"
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "TradeFlow.Api",
    "Audience": "TradeFlow.Client",
    "ExpiryInMinutes": 480
  },
  "AllowedHosts": "localhost;127.0.0.1"
}